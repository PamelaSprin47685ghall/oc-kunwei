{
  "name": "kunwei",
  "version": "0.1.0",
  "description": "OpenCode plugin: basher, editor, explorer, reverie, nudge-todo, ollama-web, refer-caps, loop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external env",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "lint": "bun x biome lint src/",
    "format": "bun x biome format --write src/",
    "check": "bun x biome check --write src/",
    "check:ci": "bun x biome check src/"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.8.4",
    "@kreuzberg/tree-sitter-language-pack-wasm": "^1.8.1",
    "@opencode-ai/plugin": "^1.15.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/node": "^24.12.4",
    "bun-types": "1.3.12",
    "typescript": "^5.9.3"
  }
}